# Copia este archivo como .env.local y rellénalo con los datos de tu proyecto de Supabase.
# Sin estas variables, la web arranca en MODO DEMO con contenido de ejemplo.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLICA

# (Solo servidor) necesaria para invitar y eliminar editores desde el panel.
SUPABASE_SERVICE_ROLE_KEY=TU-CLAVE-SERVICE-ROLE

# Opcional: URL pública del sitio (para enlaces de invitación y SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
