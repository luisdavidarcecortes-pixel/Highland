# Copia este archivo como .env.local y rellénalo con los datos de tu proyecto de Supabase.
# Sin estas variables, la web arranca en MODO DEMO con contenido de ejemplo.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLICA

# (Solo servidor) necesaria para invitar y eliminar editores desde el panel.
SUPABASE_SERVICE_ROLE_KEY=TU-CLAVE-SERVICE-ROLE

# Opcional: URL pública del sitio (para enlaces de invitación y SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini (https://aistudio.google.com/apikey → Get API key, gratis).
# Opcional: sin esta clave se usa solo la heurística local del PDF.
GEMINI_API_KEY=TU_CLAVE_DE_GEMINI

# Modelos usados por el panel (opcional). Si uno está saturado, cambia estos valores.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=20000
